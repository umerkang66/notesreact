{
  "name": "notesreact",
  "version": "0.0.1",
  "description": "Interactive browser-based JavaScript notebook CLI",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "client/build"
  ],
  "scripts": {
    "start": "tsc --watch --preserveWatchOutput",
    "start:client": "npm start --prefix client",
    "dev": "concurrently \"npm run start:client\" \"npm start\"",
    "build:client": "npm run build --prefix client",
    "build:server": "esbuild src/index.ts --platform=node --outfile=dist/index.js --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "npm run build:client && npm run build:server",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "javascript",
    "notebook",
    "react",
    "typescript",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^9.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^18.0.3",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.12",
    "typescript": "^4.7.4"
  }
}
